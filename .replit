modules = ["python-3.12"]
run = "uvicorn undefined:app --host 0.0.0.0 --port 3000"

[nix]
channel = "stable-24_05"
packages = ["bash", "cargo", "libiconv", "libxcrypt", "rustc"]

[deployment]
run = ["sh", "-c", "uvicorn undefined:app --host 0.0.0.0 --port 3000"]

[workflows]
runButton = "Angular Dev Server"

[[workflows.workflow]]
name = "Angular Dev Server"
author = 41895847
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "ng serve --host 0.0.0.0 --port 5000"
